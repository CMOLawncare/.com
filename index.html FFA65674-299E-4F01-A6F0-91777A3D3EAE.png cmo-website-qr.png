<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CMO | Local Lawn Care & More</title>

<style>
:root{
  --blue:#168cff;
  --blue-light:#55bcff;
  --black:#05070a;
  --card:#101821;
  --white:#fff;
  --gray:#9ca9b5;
  --border:rgba(255,255,255,.10);
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:var(--black);
  color:var(--white);
  line-height:1.6;
}

a{
  color:inherit;
  text-decoration:none;
}

header{
  position:sticky;
  top:0;
  z-index:10;
  background:rgba(5,7,10,.94);
  backdrop-filter:blur(15px);
  border-bottom:1px solid var(--border);
  padding:20px 7%;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.logo{
  font-size:40px;
  font-weight:900;
  letter-spacing:-3px;
}

.logo span{
  color:var(--blue);
}

.call-btn{
  background:var(--blue);
  color:#fff;
  padding:14px 23px;
  border-radius:40px;
  font-size:17px;
  font-weight:800;
}

.hero{
  padding:100px 7% 85px;
  max-width:1250px;
  margin:auto;
}

.label{
  color:var(--blue-light);
  letter-spacing:4px;
  font-weight:900;
  font-size:13px;
  margin-bottom:20px;
}

.hero h1{
  font-size:clamp(52px,9vw,95px);
  line-height:.92;
  letter-spacing:-6px;
  margin-bottom:30px;
}

.hero h1 span{
  color:var(--blue-light);
}

.hero p{
  color:var(--gray);
  font-size:21px;
  max-width:760px;
}

.section{
  padding:90px 7%;
  max-width:1250px;
  margin:auto;
}

.section-title{
  font-size:clamp(42px,7vw,65px);
  line-height:1;
  letter-spacing:-3px;
  margin-bottom:45px;
}

.card-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:22px;
}

.card{
  background:linear-gradient(145deg,#101c2a,#080e15);
  border:1px solid rgba(85,188,255,.2);
  border-radius:30px;
  padding:40px;
}

.icon{
  font-size:48px;
  margin-bottom:18px;
}

.card h3{
  font-size:42px;
  margin-bottom:12px;
}

.card-description{
  color:var(--gray);
  font-size:18px;
  margin-bottom:30px;
}

.price-list{
  border-top:1px solid var(--border);
}

.price-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  padding:23px 0;
  border-bottom:1px solid var(--border);
}

.price-row h4{
  font-size:21px;
}

.price-row p{
  color:var(--gray);
  font-size:15px;
}

.price-row strong{
  color:var(--blue-light);
  font-size:29px;
  white-space:nowrap;
}

.car-card{
  background:linear-gradient(145deg,#101c2a,#080e15);
  border:1px solid rgba(85,188,255,.2);
  border-radius:30px;
  padding:40px;
}

.car-card h2{
  font-size:48px;
  margin-bottom:10px;
}

.car-description{
  color:var(--gray);
  font-size:18px;
  margin-bottom:30px;
}

.car-option{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  padding:23px 0;
  border-top:1px solid var(--border);
}

.car-option h3{
  font-size:21px;
}

.car-option p{
  color:var(--gray);
  font-size:15px;
}

.car-price{
  color:var(--blue-light);
  font-size:31px;
  font-weight:900;
  white-space:nowrap;
}

.car-note{
  margin-top:25px;
  color:#c4ccd4;
  font-size:14px;
  text-align:center;
}

.photo-card{
  margin-top:40px;
  border-radius:30px;
  overflow:hidden;
  border:1px solid rgba(85,188,255,.2);
  box-shadow:0 20px 60px rgba(22,140,255,.12);
  background:#101821;
}

.photo-card img{
  display:block;
  width:100%;
  height:auto;
  min-height:250px;
  object-fit:cover;
}.story{
  background:#0c131b;
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
}

.story-inner{
  max-width:1250px;
  margin:auto;
  padding:100px 7%;
}

.story h2{
  font-size:clamp(42px,7vw,72px);
  line-height:1;
  letter-spacing:-4px;
  margin-bottom:28px;
}

.story h2 span{
  color:var(--blue-light);
}

.story p{
  color:var(--gray);
  font-size:19px;
  max-width:850px;
  margin-bottom:20px;
}

/* QR CODE */

.qr-section{
  text-align:center;
  padding:100px 7%;
}

.qr-section h2{
  font-size:clamp(40px,7vw,65px);
  line-height:1;
  margin-bottom:15px;
}

.qr-section > p{
  color:var(--gray);
  margin-bottom:35px;
}

.qr-box{
  max-width:390px;
  margin:auto;
  background:#fff;
  color:#05070a;
  border-radius:30px;
  padding:30px;
}

.qr-box img{
  display:block;
  width:100%;
  max-width:290px;
  margin:auto;
}

.qr-box h3{
  margin-top:20px;
  font-size:27px;
}

.qr-box p{
  color:#555;
  font-size:14px;
}

/* CONTACT */

.contact{
  padding:100px 7%;
  text-align:center;
  background:
    radial-gradient(
      circle at center,
      rgba(22,140,255,.20),
      transparent 55%
    ),
    var(--black);
}

.contact h2{
  font-size:clamp(45px,8vw,80px);
  line-height:.95;
  letter-spacing:-5px;
  margin-bottom:20px;
}

.contact > p{
  color:var(--gray);
  font-size:18px;
  margin-bottom:35px;
}

.contact-buttons{
  max-width:650px;
  margin:auto;
  display:grid;
  gap:15px;
}

.contact-button{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:22px 28px;
  border-radius:20px;
  background:var(--card);
  border:1px solid var(--border);
}

.contact-name{
  font-weight:900;
  font-size:20px;
}

.contact-number{
  color:var(--blue-light);
  font-weight:900;
}

footer{
  text-align:center;
  padding:45px 20px;
  color:var(--gray);
  border-top:1px solid var(--border);
}

footer strong{
  color:#fff;
  font-size:25px;
}

@media(max-width:700px){

  header{
    padding:17px 5%;
  }

  .logo{
    font-size:33px;
  }

  .call-btn{
    padding:11px 17px;
    font-size:15px;
  }

  .hero{
    padding:70px 5%;
  }

  .hero h1{
    letter-spacing:-4px;
  }

  .section{
    padding:70px 5%;
  }

  .card-grid{
    grid-template-columns:1fr;
  }

  .card,
  .car-card{
    padding:28px;
  }

  .card h3{
    font-size:38px;
  }

  .car-card h2{
    font-size:40px;
  }

  .car-option,
  .price-row{
    align-items:flex-start;
  }

  .price-row strong,
  .car-price{
    font-size:24px;
  }

  .contact-button{
    flex-direction:column;
    align-items:flex-start;
    gap:8px;
  }
}

</style>
</head>

<body>

<header>

  <div class="logo">
    CMO<span>.</span>
  </div>

  <a class="call-btn" href="#contact">
    📞 Call CMO
  </a>

</header>

<section class="hero">

  <div class="label">
    YOUR LOCAL AREA
  </div>

  <h1>
    Make it clean.<br>
    <span>Make it CMO.</span>
  </h1>

  <p>
    We're two neighborhood kids building our own business
    by providing affordable, reliable services to our community.
  </p>

</section>

<!-- OUR SERVICES -->

<section class="section">

  <div class="label">
    OUR SERVICES
  </div>

  <h2 class="section-title">
    Simple services.<br>
    Real work.
  </h2>

  <div class="card-grid">

    <!-- LAWN CARE -->

    <div class="card">

      <div class="icon">
        🌱
      </div>

      <h3>
        Lawn Care
      </h3>

      <p class="card-description">
        Mowing, trimming, edging, and cleaning up your lawn.
      </p>

      <div class="price-list">

        <div class="price-row">

          <div>
            <h4>
              Weekly Plan
            </h4>

            <p>
              $10 per visit
            </p>
          </div>

          <strong>
            $10 total
          </strong>

        </div>

        <div class="price-row">

          <div>
            <h4>
              Bi-Weekly
            </h4>

            <p>
              $25 per visit
            </p>
          </div>

          <strong>
            $25 total
          </strong>

        </div>

        <div class="price-row">

          <div>
            <h4>
              Season Starter
            </h4>

            <p>
              One complete service
            </p>
          </div>

          <strong>
            $119 total
          </strong>

        </div>

      </div>

    </div>


    <!-- TRASH CAN CLEANING -->

    <div class="card">

      <div class="icon">
        🗑️
      </div>

      <h3>
        Trash Can Cleaning
      </h3>

      <p class="card-description">
        We clean, rinse, and deodorize your trash cans.
      </p>

      <div class="price-list">

        <div class="price-row">

          <div>
            <h4>
              3-Can Set
            </h4>

            <p>
              $10 each
            </p>
          </div>

          <strong>
            $30 total
          </strong>

        </div>

        <div class="price-row">

          <div>
            <h4>
              5-Can Set
            </h4>

            <p>
              $8 each
            </p>
          </div>

          <strong>
            $40 total
          </strong>

        </div>

        <div class="price-row">

          <div>
            <h4>
              Single Can
            </h4>

            <p>
              $15 for one can
            </p>
          </div>

          <strong>
            $15 total
          </strong>

        </div>

      </div>

    </div>

  </div>

</section>
<!-- CAR WASH -->

<section class="section">

  <div class="label">
    03 — MOBILE CAR WASH
  </div>

  <div class="car-card">

    <div class="icon">
      🚗
    </div>

    <h2>
      Car Wash
    </h2>

    <p class="car-description">
      Choose exactly what you need. Every option is priced
      separately per car.
    </p>

    <div class="car-option">

      <div>
        <h3>
          Full Clean
        </h3>

        <p>
          Clean the outside + interior
        </p>
      </div>

      <div class="car-price">
        $20 total
      </div>

    </div>

    <div class="car-option">

      <div>
        <h3>
          Exterior Clean
        </h3>

        <p>
          Clean the outside of the car only
        </p>
      </div>

      <div class="car-price">
        $10 total
      </div>

    </div>

    <div class="car-option">

      <div>
        <h3>
          Interior Clean
        </h3>

        <p>
          Clean the interior of the car only
        </p>
      </div>

      <div class="car-price">
        $10 total
      </div>

    </div>

    <div class="car-note">
      💙 Every car-wash price shown is the total price for one car and one service.
    </div>

  </div>

</section>


<!-- FRONTIER LANE -->

<section class="section">

  <div class="label">
    OUR NEIGHBORHOOD
  </div>

  <h2 class="section-title">
    Proud to serve<br>
    <span style="color:#55bcff;">
      Frontier Lane.
    </span>
  </h2>

  <div class="photo-card">

    <img
      src="FFA65674-299E-4F01-A6F0-91777A3D3EAE.png"
      alt="Frontier Lane street sign"
    >

  </div>

</section>


<!-- OUR STORY -->

<section class="story">

  <div class="story-inner">

    <div class="label">
      OUR STORY
    </div>

    <h2>
      Just two neighborhood kids<br>
      <span>
        building something of our own.
      </span>
    </h2>

    <p>
      CMO was started by two neighborhood kids who wanted
      to build a real business, make money, and provide
      useful services for people right around us.
    </p>

    <p>
      We're learning how to work hard, take care of customers,
      and grow something we're proud of — one job at a time.
    </p>

  </div>

</section>


<!-- QR CODE -->

<section class="qr-section">

  <div class="label">
    SAVE OUR WEBSITE
  </div>

  <h2>
    Scan. Visit. CMO.
  </h2>

  <p>
    Scan the QR code to visit our website anytime.
  </p>

  <div class="qr-box">

    <img
      src="cmo-website-qr.png"
      alt="QR code for the CMO website"
    >

    <h3>
      CMO Lawn Care
    </h3>

    <p>
      Scan to visit our website.
    </p>

  </div>

</section>


<!-- CONTACT -->

<section class="contact" id="contact">

  <h2>
    Ready to get started?
  </h2>

  <p>
    Call or text Michael or Mason.
  </p>

  <div class="contact-buttons">

    <a
      class="contact-button"
      href="#contact"
    >

      <span class="contact-name">
        📞 Michael
      </span>

      <span class="contact-number">
        Call CMO
      </span>

    </a>

    <a
      class="contact-button"
      href="#contact"
    >

      <span class="contact-name">
        📞 Mason
      </span>

      <span class="contact-number">
        Call CMO
      </span>

    </a>

  </div>

</section>


<!-- FOOTER -->

<footer>

  <strong>
    CMO.
  </strong>

  <p>
    Local • Reliable • Hardworking
  </p>

  <p>
    © 2026 CMO Lawn Care
  </p>

</footer>

</body>
</html>
